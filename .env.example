# Supabase > Project Settings > Database > Connection string
# Site (Vercel): Transaction pooler, porta 6543
DATABASE_URL="postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
# Migrações (drizzle-kit): Session pooler ou conexão direta, porta 5432
DATABASE_URL_MIGRACAO="postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
